/// A trait implemented for various AST nodes, providing all pieces
/// of functionality used by `InvocationCollector`.
///
/// This trait acts as an adapter, allowing the `InvocationCollector` to interact with
/// different AST node types in a generic way. Each implementor defines how it should be
/// processed during macro invocation collection and expansion.
///
/// For n00bs: This is like a "how-to guide" for each type of code snippet (like a function,
/// or a variable declaration). It tells the macro system:
/// - How to get its unique ID (`HasNodeId`).
/// - How to check for attributes (`HasAttrs`).
/// - What kind of output it expects after a macro is expanded (`VisitOutputTy`, `FlatMapOutputTy`).
/// - How to convert itself into a generic `Annotatable` type.
/// - How to handle attributes (`pre_flat_map_node_collect_attr`, `post_flat_map_node_collect_bang`).
/// - How to "walk" its internal structure to find more macro calls (`walk`, `walk_flat_map`).
pub trait InvocationCollectorNode: HasAttrs + HasNodeId + Sized {
    /// The output type when visiting a node (e.g., `Option<Self>`).
    type VisitOutputTy;
    /// The output type when flat-mapping a node (e.g., `SmallVec<Self, 1>`).
    type FlatMapOutputTy: Default;
    /// The kind of item this node represents (e.g., `ast::ItemKind`).
    type ItemKind = ast::ItemKind; // Depends on ast
    /// The specific `AstFragmentKind` that this node corresponds to.
    const KIND: AstFragmentKind; // Depends on AstFragmentKind

    /// Converts this node into an `Annotatable` enum variant.
    fn to_annotatable(self) -> Annotatable; // Depends on Annotatable

    /// Converts an `AstFragment` into the expected `VisitOutputTy` for this node type.
    fn fragment_to_visit_output(fragment: AstFragment) -> Self::VisitOutputTy; // Depends on AstFragment

    /// Converts an `AstFragment` into the expected `FlatMapOutputTy` for this node type.
    fn fragment_to_flat_map_output(fragment: AstFragment) -> Self::FlatMapOutputTy; // Depends on AstFragment

    /// Provides a human-readable description of the node type.
    fn descr() -> &'static str { unreachable!() }

    /// Walks the internal structure of the node, collecting macro invocations.
    ///
    /// The `_collector` argument is commented out for now to avoid compilation errors
    /// until `InvocationCollector` is moved.
    fn walk_flat_map<D>(self, _collector: &mut D) -> Self::FlatMapOutputTy;
    fn walk<D>(&mut self, _collector: &mut D);

    /// Checks if the node represents a macro call.
    fn is_mac_call(&self) -> bool { false }

    /// Takes ownership of the macro call information from the node.
//     fn take_mac_call(self) -> (Box<ast::MacCall>, ast::AttrVec, AddSemicolon) { unreachable!() } // Depends on ast::MacCall, ast::AttrVec, AddSemicolon
        fn take_mac_call(self) -> (Box<ast::MacCall>, ast::AttrVec, AddSemicolon) {
        let (mac, attrs, add_semicolon) = match self.0.kind {
            ast::StmtKind::MacCall(mac_stmt) => (mac_stmt.mac, mac_stmt.attrs, AddSemicolon::Yes),
            _ => panic!("called take_mac_call on non-macro statement"),
        };
        (mac, attrs, add_semicolon)
    }


    /// Handles delegation macros.
    fn delegation(&self) -> Option<(&ast::DelegationMac, &ast::Item<Self::ItemKind>)> { None } // Depends on ast::DelegationMac, ast::Item
    fn delegation_item_kind(_deleg: Box<ast::Delegation>) -> Self::ItemKind { unreachable!() } // Depends on ast::Delegation
    fn from_item(_item: ast::Item<Self::ItemKind>) -> Self { unreachable!() } // Depends on ast::Item

    /// Flattens an iterator of `FlatMapOutputTy` into a single `FlatMapOutputTy`.
    fn flatten_outputs(_outputs: impl Iterator<Item = Self::FlatMapOutputTy>) -> Self::FlatMapOutputTy { unreachable!() }

    /// Hook for collecting attributes before flat-mapping the node.
    ///
    /// The `_cfg` argument is commented out for now to avoid compilation errors
    /// until `StripUnconfigured` is moved.
    fn pre_flat_map_node_collect_attr<F>(_cfg: &F, _attr: &ast::Attribute) {} // Depends on ast::Attribute

    /// Hook for collecting attributes after flat-mapping the node with a bang macro.
    fn post_flat_map_node_collect_bang(_output: &mut Self::FlatMapOutputTy, _add_semicolon: AddSemicolon) {} // Depends on AddSemicolon

    /// Wraps the `walk_flat_map` call, allowing for custom pre/post processing.
    ///
    /// The `collector` argument is commented out for now.
    fn wrap_flat_map_node_walk_flat_map<D>(
        node: Self,
        _collector: &mut D,
        walk_flat_map: impl FnOnce(Self, &mut D) -> Self::FlatMapOutputTy,
    ) -> Result<Self::FlatMapOutputTy, Self> {
        Ok(walk_flat_map(node, _collector))
    }

    /// Expands the node when a `#[cfg(FALSE)]` attribute is encountered.
    ///
    /// The `collector` and `span` arguments are commented out for now.
    // fn expand_cfg_false(&mut self, collector: &mut InvocationCollector<'_, '_'>, pos: usize, span: Span) {
    //     // Handle cfg_false logic for statement
    //     collector.cx.sess.psess.buffer_lint(
    //         StripUnconfigured::get_unused_attribute_lint(true),
    //         span,
    //         collector.cx.current_expansion.lint_node_id,
    //         errors::CfgFalseRemoved { span },
    //     );
    //     self.visit_attrs(|attrs| {
    //         attrs.remove(pos);
    //     });
    // }


    /// Returns a list of identifiers declared by this node. Used for diagnostics.
    fn declared_idents(&self) -> Vec<Ident> { vec![] }
}

