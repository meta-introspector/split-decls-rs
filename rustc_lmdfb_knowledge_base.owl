    lmdfb:hasEmoji "📦" ;
    lmdfb:hasSemanticPattern lmdfb:general_utility ;
    lmdfb:lmdfb:usesPowerOfTwo 2 ;
    lmdfb:lmdfb:usesPrime 2 ;
    .

